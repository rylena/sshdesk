#!/bin/sh
set -eu

# Read only fixed keys from a root-owned per-account file. Nothing is evaluated.
account="$(id -un)"
config="/etc/sshdesk/${account}.conf"
if [ -r "${config}" ]; then
    while IFS='=' read -r key value; do
        case "${key}" in
            DISPLAY) DISPLAY="${value}" ;;
            XAUTHORITY) XAUTHORITY="${value}" ;;
            WAYLAND_DISPLAY) WAYLAND_DISPLAY="${value}" ;;
            XDG_RUNTIME_DIR) XDG_RUNTIME_DIR="${value}" ;;
            XDG_SESSION_TYPE) XDG_SESSION_TYPE="${value}" ;;
            XDG_CURRENT_DESKTOP) XDG_CURRENT_DESKTOP="${value}" ;;
            DBUS_SESSION_BUS_ADDRESS) DBUS_SESSION_BUS_ADDRESS="${value}" ;;
            YDOTOOL_SOCKET) YDOTOOL_SOCKET="${value}" ;;
            RUN_AS) RUN_AS="${value}" ;;
            SSHDESK_RENDER) SSHDESK_RENDER="${value}" ;;
            SSHDESK_COLOR) SSHDESK_COLOR="${value}" ;;
            SSHDESK_MOUSE) SSHDESK_MOUSE="${value}" ;;
            SSHDESK_UNICODE) SSHDESK_UNICODE="${value}" ;;
            SSHDESK_X11_CAPTURE) SSHDESK_X11_CAPTURE="${value}" ;;
            SSHDESK_MAX_FPS) SSHDESK_MAX_FPS="${value}" ;;
            SSHDESK_SCALE) SSHDESK_SCALE="${value}" ;;
        esac
    done < "${config}"
fi

: "${DISPLAY:=:0}"
: "${XAUTHORITY:=${HOME}/.Xauthority}"
: "${RUN_AS:=${account}}"
case "${RUN_AS}" in
    *[!A-Za-z0-9_.-]*|'') echo "Invalid SSHDESK desktop account." >&2; exit 1 ;;
esac
export DISPLAY XAUTHORITY
[ -z "${WAYLAND_DISPLAY-}" ] || export WAYLAND_DISPLAY
[ -z "${XDG_RUNTIME_DIR-}" ] || export XDG_RUNTIME_DIR
[ -z "${XDG_SESSION_TYPE-}" ] || export XDG_SESSION_TYPE
[ -z "${XDG_CURRENT_DESKTOP-}" ] || export XDG_CURRENT_DESKTOP
[ -z "${DBUS_SESSION_BUS_ADDRESS-}" ] || export DBUS_SESSION_BUS_ADDRESS
[ -z "${YDOTOOL_SOCKET-}" ] || export YDOTOOL_SOCKET
export SSHDESK_RENDER="${SSHDESK_RENDER-auto}"
export SSHDESK_COLOR="${SSHDESK_COLOR-auto}"
export SSHDESK_MOUSE="${SSHDESK_MOUSE-auto}"
export SSHDESK_UNICODE="${SSHDESK_UNICODE-auto}"
export SSHDESK_X11_CAPTURE="${SSHDESK_X11_CAPTURE-auto}"
export SSHDESK_MAX_FPS="${SSHDESK_MAX_FPS-auto}"
export SSHDESK_SCALE="${SSHDESK_SCALE-auto}"

require_pty() {
    message="$1"
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "${message}" >&2
        exit 1
    fi
}

run_server() {
    require_pty "SSHDESK requires an interactive SSH terminal (PTY)."
    if [ "${RUN_AS}" != "${account}" ]; then
        exec /usr/bin/sudo -n -u "${RUN_AS}" -- \
            /usr/local/bin/sshdesk-server
    fi
    exec /usr/local/bin/sshdesk-server
}

run_agent() {
    if [ "${RUN_AS}" != "${account}" ]; then
        exec /usr/bin/sudo -n -u "${RUN_AS}" -- \
            /usr/local/bin/sshdesk-agent-ssh "${SSH_ORIGINAL_COMMAND}"
    fi
    exec /usr/local/bin/sshdesk-agent-ssh "${SSH_ORIGINAL_COMMAND}"
}

run_shell() {
    if command -v getent >/dev/null 2>&1; then
        login_shell="$(getent passwd "${account}" | cut -d: -f7)"
    else
        login_shell="${SHELL:-/bin/sh}"
    fi
    case "${login_shell}" in
        /*) ;;
        *) echo "Invalid SSH login shell." >&2; exit 1 ;;
    esac
    [ -x "${login_shell}" ] || {
        echo "SSH login shell is unavailable: ${login_shell}" >&2
        exit 1
    }
    require_pty "The SSH shell selector requires an interactive terminal (PTY)."
    exec "${login_shell}" -l
}

if [ -n "${SSH_ORIGINAL_COMMAND-}" ]; then
    case "${SSH_ORIGINAL_COMMAND}" in
        desktop|sshdesk|sshdesk-server)
            run_server
            ;;
        shell|sshdesk-shell)
            run_shell
            ;;
        sshdesk-agent|sshdesk-agent\ *|*/sshdesk-agent|*/sshdesk-agent\ *)
            run_agent
            ;;
        *)
            run_agent
            ;;
    esac
fi

run_server
